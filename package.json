{
  "name": "wornpage",
  "private": true,
  "description": "Wornpage — Svelte 5 component library and development toolkit. A collection of reusable UI components, CSS audit tools, and the CLI that ties them together.",
  "workspaces": [
    "packages/*",
    "tools/*",
    "demo"
  ],
  "scripts": {
    "build": "bun run --cwd demo build",
    "test": "bun test --coverage",
    "lint": "bun run --filter '*' lint",
    "clean": "rm -rf packages/*/dist tools/*/dist packages/*/node_modules tools/*/node_modules",
    "check:components": "bun run scripts/check-component-delivery.ts",
    "check:workspace": "bun run scripts/check-workspace-contract.ts",
    "new": "bun run packages/cli/src/index.ts new",
    "sync": "bun run scripts/sync.ts"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": "wornpage/wornpage",
  "license": "MIT"
}
