{
  "name": "@wornpage/undo",
  "version": "0.1.1",
  "description": "Svelte 5 undo receipt and bounded snapshot stack with accessible browser events",
  "type": "module",
  "wornpage": {
    "contractVersion": 2,
    "delivery": "browser-bundle"
  },
